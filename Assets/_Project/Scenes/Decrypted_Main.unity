  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 302501853}
  _title: 
  _body: 'America''s own cipher machine stepped its rotors irregularly, driven by
    a second bank of rotors, defeating the predictability that doomed Enigma. No
    wartime adversary is known to have read a single SIGABA message.


    <b>SIGNIFICANCE</b> 
    The quiet hero of Allied security, a reminder that the best cipher is the one
    the enemy never even realises they have failed to break.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
