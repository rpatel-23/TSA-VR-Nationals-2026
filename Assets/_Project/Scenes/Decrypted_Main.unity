  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 181657702}
  _title: 
  _body: 'A new generation of ciphers builds its locks from mathematical problems,
    tangled lattices in high-dimensional space, that even a quantum computer cannot
    easily solve. In 2024 the first such standards were published for the world to
    adopt.


    <b>SIGNIFICANCE</b>

    The next chapter of the three-thousand-year
    duel, being written right now, and the cipher that may guard your grandchildren''s
    secrets.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
