  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1840661132}
  _title: 
  _body: 'Whitfield Diffie and Martin Hellman solved the impossible: two people shouting
    across a crowded room can mix their colours of paint so that each ends with the
    same secret blend, while no listener can un-mix it.


    <b>SIGNIFICANCE</b> 
    The first public-key idea ever published, ''New Directions in Cryptography''
    ended four thousand years of needing to share a key in advance.'
  _group: {fileID: 0}
