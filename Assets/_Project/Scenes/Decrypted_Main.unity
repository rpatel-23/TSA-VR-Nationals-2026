  _titleField: {fileID: 0}
  _bodyField: {fileID: 1845537531}
  _title: 
  _body: 'A hash function crushes any file, a word or a library, into a short fingerprint.
    Change a single comma and the fingerprint changes utterly, yet you can never
    run it backwards to recover the original.


    <b>SIGNIFICANCE</b>  How your
    password is stored without being kept, and how the world checks that a file has
    not been tampered with.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
