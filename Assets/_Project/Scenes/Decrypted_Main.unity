  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 876561143}
  _title: 
  _body: 'The biographer Suetonius records that Caesar replaced each letter with
    the one three places further on. Augustus, his heir, preferred a shift of one.
    Simple, fast, and good enough against a largely illiterate foe.


    <b>SIGNIFICANCE</b> 
    The most famous cipher in history, and the namesake of every ''shift cipher''
    taught since.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
