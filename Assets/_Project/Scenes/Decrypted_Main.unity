  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1364097769}
  _title: 
  _body: 'The abbot Johannes Trithemius published a square table of twenty-six alphabets,
    each shifted one further than the last, and stepped through them letter by letter,
    a new cipher alphabet for every position.


    <b>SIGNIFICANCE</b>

    The
    table at the heart of nearly every Renaissance polyalphabetic cipher, including
    the one that would baffle Europe for three centuries.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
