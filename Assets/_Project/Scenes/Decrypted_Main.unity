  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1610388125}
  _title: 
  _body: "A keyword chooses a different alphabet from Trithemius' table for each
    letter of the message, then repeats. Misattributed to Blaise de Vigen\xE8re,
    it was so resistant to frequency analysis that Europe called it 'le chiffre ind\xE9chiffrable',
    the unbreakable cipher.\n\n<b>SIGNIFICANCE</b>\nFor 300 years it was the gold
    standard of secrecy, until Charles Babbage and Friedrich Kasiski found the crack
    in its repeating key."
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
