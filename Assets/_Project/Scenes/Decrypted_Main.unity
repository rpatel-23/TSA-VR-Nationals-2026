  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 2055802214}
  _title: 
  _body: 'Claude Shannon turned secrecy into mathematics. He defined information
    in bits, proved exactly when a cipher is unbreakable, and showed that good ciphers
    must blend ''confusion'' and ''diffusion'' to hide every trace of the message.


    <b>SIGNIFICANCE</b> 
    The birth of the information age. Every cipher since is measured against the
    limits Shannon set.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
