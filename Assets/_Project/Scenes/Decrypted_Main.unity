  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 824425442}
  _title: 
  _body: 'U.S. Marines in the Pacific transmitted orders in Navajo, a language almost
    unwritten and spoken by few outside the Nation. Layered with a code of its own,
    it carried messages in seconds that machines needed hours to encipher.


    <b>SIGNIFICANCE</b> 
    The only major military code of the war that the enemy never broke, spoken by
    the very people America had tried to silence.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
