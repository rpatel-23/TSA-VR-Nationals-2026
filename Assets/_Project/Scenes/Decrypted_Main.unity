  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 2032522390}
  _title: 
  _body: 'A strip of parchment wound around a wooden rod of an exact diameter. Written
    along the staff, then unwound, the letters scatter into nonsense; only a rod
    of the matching thickness lines them up again.


    <b>SIGNIFICANCE</b>  The
    earliest known military cipher, and the first transposition, hiding a message
    by reordering it rather than replacing its letters.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
