  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 930067489}
  _title: 
  _body: 'Imagine a mailbox with a slot: anyone can drop a letter in (the public
    key), but only the owner''s key opens it to read (the private key). You never
    have to share the opening key to receive a secret.


    <b>SIGNIFICANCE</b> 
    This single metaphor explains why you can shop and bank online with people you
    have never met.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
