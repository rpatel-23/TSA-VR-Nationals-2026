  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1091983186}
  _title: 
  _body: 'Rivest, Shamir and Adleman gave everyone two keys: a public one that anyone
    can use to lock a message, and a private one that only you can use to unlock
    it. Its security rests on the difficulty of factoring enormous numbers.


    <b>SIGNIFICANCE</b> 
    The padlock of the internet. RSA lets total strangers exchange secrets safely,
    the foundation of e-commerce, email and secure login.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
