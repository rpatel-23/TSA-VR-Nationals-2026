  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1357635834}
  _title: 
  _body: 'In the House of Wisdom in Baghdad, the polymath Al-Kindi noticed that every
    language uses some letters more than others. Count the symbols, match the most
    common to ''E'' or its equivalent, and any simple substitution unravels.


    <b>SIGNIFICANCE</b>

    Frequency
    analysis, the birth of cryptanalysis. For 600 years it made every monalphabetic
    cipher readable to a patient mind.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
