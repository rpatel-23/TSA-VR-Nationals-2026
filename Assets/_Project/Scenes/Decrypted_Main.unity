  m_Script: {fileID: 11500000, guid: bdf042366cb29494ba42e5cf6228c30f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 1863699909}
  _title: 
  _body: "The Greek historian Polybius arranged the alphabet in a 5\xD75 grid, so
    every letter became a pair of numbers, its row and column. Signalled with torches,
    it let messages cross valleys letter by letter.\n\n<b>SIGNIFICANCE</b>\nIt turned
    letters into numbers two thousand years before computers did the same, and underlies
    many later ciphers."
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
  _fixedFacing: 1
