  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 285888376}
  _title: 
  _body: 'The U.S. government adopted the Data Encryption Standard so that banks
    and businesses could all encrypt the same way. Its 56-bit key, controversially
    short, was finally cracked by brute force in 1998 in just 56 hours.


    <b>SIGNIFICANCE</b>

    The
    first cipher the whole world shared, and the moment cryptography became public
    infrastructure rather than a military secret.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
