  m_Name: 
  m_EditorClassIdentifier: 
  _titleField: {fileID: 0}
  _bodyField: {fileID: 106215652}
  _title: 
  _body: 'Hitler''s high command used the Lorenz cipher, even tougher than Enigma.
    To break it, engineer Tommy Flowers built Colossus from 1,600 vacuum tubes, the
    world''s first programmable electronic digital computer.


    <b>SIGNIFICANCE</b> 
    The secret war gave birth to the computer age. Colossus stayed classified for
    thirty years, robbing its builders of the credit.'
  _group: {fileID: 0}
  _revealRadius: 14
  _fullRadius: 7
  _fadeLerp: 6
  _alwaysVisible: 0
  _billboardYaw: 0
  _billboardLerp: 3
